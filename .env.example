# RevenueCat public SDK keys (Trace Forever). Safe to ship — they can only
# start a purchase; the unlock is written server-side by the webhook.
# Leave blank and the app runs free-tier only, with purchases disabled.
# See MONETIZATION.md for where these come from.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Where password-recovery emails send people. This URL must ALSO be listed in
# Supabase → Authentication → URL Configuration → Redirect URLs, or the link in
# the email will bounce. See ACCOUNT.md.
